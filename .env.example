# Copy this file to .env.local and fill in real values. Never commit .env.local.

# League of Legends: Riot personal API key from https://developer.riotgames.com
# (dev keys expire every 24 hours and must be regenerated)
RIOT_API_KEY=RGAPI-your-key-here

# Spotify: create an app at https://developer.spotify.com/dashboard
# Register redirect URIs: http://127.0.0.1:3000/api/spotify/callback (local)
# and https://YOUR-SITE/api/spotify/callback (live). "localhost" is not allowed.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
